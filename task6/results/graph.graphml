  <data key="d3">{"pair_id": "R00006", "condition": "初入高原的朋友", "normalized_condition": "初入高原的朋友", "recommendation": "第一日尽量不进行剧烈的运动", "normalized_recommendation": "第一日尽量不进行剧烈的运动", "condition_type": "体力与健康", "rule": "advice_only", "source_text": "两天的时间对于游览九寨沟来说恰到好处，初入高原的朋友，建议第一日尽量不进行剧烈的运动，所以第一天是适应期，主要游览则渣洼沟和树正沟，第二天则是徒步居多，主要游览九寨沟的精华日则沟。", "evidence_span": "初入高原的朋友，建议第一日尽量不进行剧烈的运动", "doc_id": "jiuzhaigou_official_88ef5cc31789dc71", "url": "https://www.jiuzhai.com/intelligent-service/way-of-play", "extraction_method": "regex+LLM", "review_status": "独立LLM辅助审核及证据复核；待真实人工确认", "audit_candidate": false, "source_count": 1}</data>
