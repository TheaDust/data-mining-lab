  <data key="d3">{"pair_id": "F00019", "condition": "如果是分配到右线开始", "normalized_condition": "是分配到右线开始", "recommendation": "放弃左线，深度玩右线", "normalized_recommendation": "放弃左线深度玩右线", "condition_type": "交通条件", "rule": null, "source_text": "如果是分配到右线开始：\n这边是建议放弃左线，深度玩右线，因为五花海很吃光线，最佳观赏时间是中午和下午，所以早上就在原始森林慢悠悠的逛，然后10:00大概阳光出来了就开始从原始森林徒步到天鹅海。", "evidence_span": "如果是分配到右线开始：\n这边是建议放弃左线，深度玩右线", "doc_id": "jiuzhaigou_user_generated_0ed001d738cb93a5", "url": "https://www.xiaohongshu.com/explore/6ae2a985000000002c023fae", "extraction_method": "原自动抽取/漏抽样本 + 独立LLM辅助审核 + 原文证据复核", "review_status": "独立LLM辅助审核及证据复核；待真实人工确认", "audit_candidate": false, "source_count": 1}</data>
