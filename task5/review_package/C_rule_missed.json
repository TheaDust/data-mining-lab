    "source_type_label": "游客游记",
    "source_title": "用末代皇帝溥仪的视角，带孩子游故宫",
    "source_url": "https://www.xiaohongshu.com/explore/6a16b53c0000000008003c9b",
    "source_text": "-————————————————————————-",
    "source_start": 133,
    "source_end": 159,
